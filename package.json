{
  "name": "workout-programming-spa",
  "version": "3.0.0",
  "description": "Cloudflare Workers and D1 workout programming app",
  "type": "module",
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed/local.sql",
    "db:setup": "npm run db:migrate:local && npm run db:seed:local",
    "db:reset:local": "node scripts/reset-d1-state.mjs local && npm run db:setup",
    "db:migrate:e2e": "wrangler d1 migrations apply DB --local --persist-to .wrangler/e2e",
    "db:seed:e2e": "wrangler d1 execute DB --local --persist-to .wrangler/e2e --file=./seed/local.sql",
    "db:setup:e2e": "node scripts/reset-d1-state.mjs e2e && npm run db:migrate:e2e && npm run db:seed:e2e",
    "dev": "npm run db:setup && vite",
    "dev:e2e": "npm run db:setup:e2e && vite --mode e2e",
    "dev:server": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "bootstrap": "^5.3.2",
    "hono": "^4.13.3",
    "react": "^18.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
